NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Market data providers. Server-side only — never prefix these with NEXT_PUBLIC_,
# which would inline them into the browser bundle and expose the key to anyone.
TWELVEDATA_API_KEY=

# InsForge project admin key. Used only by server-side market ingestion, which
# writes to tables that have no write policy for end users. Bypasses RLS, so it
# must stay in server code and never reach a client component.
INSFORGE_API_KEY=
